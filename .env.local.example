# SSO app tổng (account.hpcore.vn) — service account project "hpcons-portal".
# Xin lại từ Firebase Console (hpcons-portal > Project settings > Service accounts)
# hoặc từ Sếp nếu đã dùng cho ITAsset/pkd_crm-next.
HPCORE_FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Firebase project riêng của base-request-app (Firestore nghiệp vụ: groups/categories/requests).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Đồng bộ đề xuất đã duyệt sang QLK CTR (app quản lý kho công trình) — để trống QLKCTR_API_URL
# thì tính năng này tự tắt (không gửi gì, không lỗi). Xem openspec/changes/add-qlkctr-sync-webhook.
QLKCTR_API_URL=
QLKCTR_API_KEY=

# Đồng bộ đề xuất đã duyệt sang App Thu mua (module mua hàng) — NHÁNH RIÊNG, độc lập với
# QLKCTR_API_URL ở trên. Khác QLK CTR: gọi cho MỌI đề xuất duyệt xong, có công trình hay
# không. Để trống THUMUA_API_URL thì tự tắt, không gửi gì, không lỗi. Xem lib/thumua-sync.ts.
THUMUA_API_URL=
THUMUA_API_KEY=

# Đồng bộ đề xuất nhóm "(EQUI)" đã duyệt sang App EQUI (equi.hpcore.vn) — "Liên kết mua hàng EQUI"
# (16/10/2026). Nhóm "(EQUI)" gửi App EQUI + Thu mua, KHÔNG gửi QLK CTR. Chỉ phiếu "Đề nghị lô hàng SX"
# mới tạo đề nghị bên EQUI; sự kiện sau duyệt (xoá/khôi phục/điều chỉnh/thêm tệp) gửi cùng địa chỉ.
# Khác QLK CTR: thiếu một trong hai biến thì việc gửi App EQUI DỪNG với lỗi "Chưa cấu hình ..." (xem
# trang Lịch sử Webhook) — App EQUI thiếu khoá cũng đóng cổng. Xem lib/equi-sync.ts, lib/dong-bo/gui.ts.
EQUI_API_URL=
EQUI_API_KEY=
